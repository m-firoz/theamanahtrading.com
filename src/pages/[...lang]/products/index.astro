---
import Base from '../../../layouts/Base.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { localeParams, useTranslations } from '../../../i18n/config';
import { getProducts, groupIds } from '../../../lib/products';

export function getStaticPaths() { return localeParams(); }
const { locale } = Astro.props;
const t = useTranslations(locale);
const products = await getProducts();
const groups = groupIds.map((id) => ({ id, name: t(`groups.${id}`), items: products.filter((p) => p.group === id) })).filter((g) => g.items.length);
---
<Base locale={locale} path="/products/" title={t('products.title')}>
  <section class="section">
    <div class="wrap">
      <h1>{t('products.title')}</h1>
      <p class="muted">{t('products.intro')}</p>
      <ul class="chips" id="filters" hidden>
        <li><button type="button" class="chip" data-filter="all" aria-pressed="true">{t('categories.all')} <span class="n">{products.length}</span></button></li>
        {groups.map((g) => (
          <li><button type="button" class="chip" data-filter={g.id} aria-pressed="false">{g.name} <span class="n">{g.items.length}</span></button></li>
        ))}
      </ul>
      <div class="catalog" id="catalog" data-filter="all">
        {groups.map((g) => (
          <section class="group" data-group={g.id} aria-labelledby={`h-${g.id}`}>
            <div class="group-head">
              <h2 id={`h-${g.id}`}>{g.name}</h2>
              <a class="see-all" href={`?group=${g.id}`} data-see-all={g.id}>{t('products.seeAll', { n: g.items.length })}</a>
              <div class="rail-tools" data-tools hidden>
                <button type="button" class="round" data-prev aria-label={t('products.prev')}>←</button>
                <button type="button" class="round" data-next aria-label={t('products.next')}>→</button>
              </div>
            </div>
            <ul class="rail" role="list" data-track tabindex="0" aria-label={t('products.rail', { name: g.name })}>
              {g.items.map((p) => <ProductCard product={p} locale={locale} />)}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>
</Base>
<script>
  // Everything here is an enhancement: without JavaScript all products stay visible and the rows still scroll.
  const bar = document.getElementById('filters')!;
  const catalog = document.getElementById('catalog')!;
  const groups = [...catalog.querySelectorAll<HTMLElement>('.group')];
  const buttons = [...bar.querySelectorAll<HTMLButtonElement>('button')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function apply(id: string, remember: boolean) {
    catalog.dataset.filter = id;
    groups.forEach((g) => { g.hidden = id !== 'all' && g.dataset.group !== id; });
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === id)));
    if (remember) {
      const u = new URL(location.href);
      if (id === 'all') u.searchParams.delete('group'); else u.searchParams.set('group', id);
      history.replaceState(null, '', u);
    }
    groups.forEach(updateArrows);
  }

  function updateArrows(g: HTMLElement) {
    const track = g.querySelector<HTMLElement>('[data-track]')!;
    const tools = g.querySelector<HTMLElement>('[data-tools]')!;
    const prev = tools.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = tools.querySelector<HTMLButtonElement>('[data-next]')!;
    const filtered = catalog.dataset.filter !== 'all';
    const overflow = track.scrollWidth > track.clientWidth + 4;
    tools.hidden = filtered || !overflow;
    prev.disabled = track.scrollLeft <= 2;
    next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
  }

  groups.forEach((g) => {
    const track = g.querySelector<HTMLElement>('[data-track]')!;
    const go = (dir: number) => track.scrollBy({ left: dir * track.clientWidth * 0.85, behavior: reduce ? 'auto' : 'smooth' });
    g.querySelector('[data-prev]')!.addEventListener('click', () => go(-1));
    g.querySelector('[data-next]')!.addEventListener('click', () => go(1));
    track.addEventListener('scroll', () => updateArrows(g), { passive: true });
    g.querySelector('[data-see-all]')!.addEventListener('click', (e) => {
      e.preventDefault();
      apply(g.dataset.group!, true);
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  });
  window.addEventListener('resize', () => groups.forEach(updateArrows));

  bar.hidden = false;
  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!, true)));
  const initial = new URLSearchParams(location.search).get('group');
  apply(initial && buttons.some((b) => b.dataset.filter === initial) ? initial : 'all', false);
  addEventListener('load', () => groups.forEach(updateArrows));
</script>
