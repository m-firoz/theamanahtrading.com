---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import hero from '../../assets/home/hero-market.jpg';
import tileRice from '../../assets/home/tile-rice.jpg';
import tileSpices from '../../assets/home/tile-spices.jpg';
import tileRange from '../../assets/home/tile-range.jpg';
import { site } from '../../config/site';
import { getUi, localeParams, localePath, useTranslations } from '../../i18n/config';
import { getProducts } from '../../lib/products';

export function getStaticPaths() { return localeParams(); }
const { locale } = Astro.props;
const t = useTranslations(locale);
const ui = getUi(locale);
const products = await getProducts();
const count = (g: string) => products.filter((p) => p.group === g).length;
const tiles = [
  { img: tileRice, cls: 'rice', title: t('groups.rice'), count: t('supply.count', { n: count('rice') }), href: localePath(locale, '/products/') + '?group=rice' },
  { img: tileSpices, cls: 'spices', title: t('groups.spices'), count: t('supply.count', { n: count('spices') }), href: localePath(locale, '/products/') + '?group=spices' },
  { img: tileRange, cls: 'range', title: t('supply.range'), count: t('supply.all', { n: products.length }), href: localePath(locale, '/products/') },
];
---
<Base locale={locale} path="/">
  <section class="hero">
    <Image class="hero-bg" src={hero} alt="" widths={[900, 1600, 2400]} sizes="100vw" format="webp" loading="eager" />
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <h1>{t('hero.title')}</h1>
        <p>{t('hero.text')}</p>
      </div>
      <div class="hero-cta">
        <a class="hero-btn" href={localePath(locale, '/products/')}>{t('hero.quote')}</a>
      </div>
      <ul class="hero-facts">
        {ui.hero.facts.map((f: { title: string; text: string }) => (
          <li><strong>{f.title}</strong><span>{f.text}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="center">{t('supply.title')}</h2>
      <ul class="tiles">
        {tiles.map((x) => (
          <li>
            <a class={`tile ${x.cls}`} href={x.href}>
              <Image src={x.img} alt="" widths={[600, 1000]} sizes="(min-width: 800px) 33vw, 100vw" format="webp" loading="lazy" />
              <span class="tile-text"><strong>{x.title}</strong><small>{x.count}</small></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section how" id="how">
    <div class="wrap">
      <h2 class="center">{ui.how.title}</h2>
      <ol class="how-steps">
        {ui.how.steps.map((s: { title: string; text: string }) => (
          <li><span class="num" aria-hidden="true"></span><h3>{s.title}</h3><p>{s.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section contact-band" id="contact">
    <div class="wrap">
      <h2 class="center">{t('contact.title')}</h2>
      <p class="center lead">{t('contact.text')}</p>
      <div class="contact-cols">
        <div class="contact-actions">
          <a class="btn honey" href={`tel:${site.phoneTel}`}>{t('hero.call')}: {site.phoneDisplay}</a>
          <a class="btn outline-light" href={`mailto:${site.email}`}>{t('contact.emailUs')}: {site.email}</a>
        </div>
        <p class="hours">{t('contact.hours')}: {site.hours} ({site.timeZoneLabel})</p>
      </div>
    </div>
  </section>
</Base>
