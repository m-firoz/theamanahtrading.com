---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '@fontsource/noto-sans-thai/400.css';
import '@fontsource/noto-sans-thai/600.css';
import '@fontsource/noto-sans-khmer/400.css';
import '@fontsource/noto-sans-khmer/600.css';
import '@fontsource/noto-sans-lao/400.css';
import '@fontsource/noto-sans-lao/600.css';
import '../styles/global.css';
import { site } from '../config/site';
import { locales, localePath, useTranslations, defaultLocale, type Locale } from '../i18n/config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props { locale: Locale; title?: string; description?: string; path?: string; noindex?: boolean }
const { locale, title, description, path = '/', noindex = false } = Astro.props;
const t = useTranslations(locale);
const fullTitle = title ? `${title} | ${site.name}` : site.name;
const desc = description ?? t('meta.description');
const abs = (l: Locale) => new URL(localePath(l, path), site.url).href;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={abs(locale)} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={abs(l)} />)}
    <link rel="alternate" hreflang="x-default" href={abs(defaultLocale)} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={abs(locale)} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F5F7F9" />
  </head>
  <body>
    <a class="skip" href="#main">{t('nav.skip')}</a>
    <Header locale={locale} path={path} />
    <main id="main"><slot /></main>
    <Footer locale={locale} />
    <ConsentBanner locale={locale} />
  </body>
</html>
