---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-horizontal.png';
import { locales, localeNames, localePath, useTranslations, type Locale } from '../i18n/config';
import QuoteBadge from './QuoteBadge';
interface Props { locale: Locale; path: string }
const { locale, path } = Astro.props;
const t = useTranslations(locale);
const links = [
  { href: localePath(locale, '/products/'), label: t('nav.products'), current: path.startsWith('/products') },
  { href: localePath(locale, '/') + '#how', label: t('nav.how') },
  { href: localePath(locale, '/about/'), label: t('nav.about'), current: path.startsWith('/about') },
  { href: localePath(locale, '/') + '#contact', label: t('nav.contact') },
];
const quoteHref = localePath(locale, '/quote/');
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={localePath(locale, '/')} aria-label={t('nav.home')}>
      <Image src={logo} alt="" height={108} widths={[160, 320]} sizes="160px" format="png" loading="eager" />
    </a>
    <nav class="nav desktop" aria-label={t('nav.main')}>
      {links.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <details class="lang desktop-lang">
      <summary aria-label={t('nav.language')}>{localeNames[locale]}</summary>
      <ul>
        {locales.map((l) => (
          <li><a href={localePath(l, path)} lang={l} hreflang={l} aria-current={l === locale ? 'true' : undefined}>{localeNames[l]}</a></li>
        ))}
      </ul>
    </details>
    <a class="btn small quote-btn desktop-quote" href={quoteHref}>{t('nav.quote')}<QuoteBadge client:load /></a>
    <a class="quote-icon" href={quoteHref} aria-label={t('nav.quote')}>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="5" y="4" width="14" height="17" rx="2" /><path d="M9 4.5V3h6v1.5" /><path d="M9 10h6M9 14h6M9 18h3" />
      </svg>
      <QuoteBadge client:load />
    </a>
    <div class="menu-wrap">
      <details class="menu">
        <summary aria-label={t('nav.menu')}><span class="burger" aria-hidden="true"></span></summary>
        <div class="panel">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
          <div class="langs" role="group" aria-label={t('nav.language')}>
            {locales.map((l) => <a href={localePath(l, path)} lang={l} hreflang={l} aria-current={l === locale ? 'true' : undefined}>{localeNames[l]}</a>)}
          </div>
          <a class="btn small" href={quoteHref}>{t('nav.quote')}</a>
        </div>
      </details>
    </div>
  </div>
</header>
