---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-footer.png';
import { site } from '../config/site';
import { localePath, useTranslations, type Locale } from '../i18n/config';
const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <Image src={logo} alt={site.name} height={120} widths={[240, 480]} sizes="240px" format="png" loading="lazy" />
      </div>
      <div>
        <h2>{t('footer.explore')}</h2>
        <ul>
          <li><a href={localePath(locale, '/products/')}>{t('nav.products')}</a></li>
          <li><a href={localePath(locale, '/') + '#how'}>{t('nav.how')}</a></li>
          <li><a href={localePath(locale, '/about/')}>{t('nav.about')}</a></li>
          <li><a href={localePath(locale, '/quote/')}>{t('nav.quote')}</a></li>
        </ul>
      </div>
      <div>
        <h2>{t('footer.legal')}</h2>
        <ul>
          <li><a href={localePath(locale, '/privacy/')}>{t('footer.privacy')}</a></li>
          <li><button type="button" class="link-btn" data-open-consent>{t('consent.settings')}</button></li>
        </ul>
      </div>
      <div>
        <h2>{t('footer.contact')}</h2>
        <ul>
          <li><a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>{site.hours} ({site.timeZoneLabel})</li>
        </ul>
      </div>
    </div>
    <p class="copy">© {new Date().getFullYear()} {site.legalName} {t('footer.rights')}</p>
  </div>
</footer>
