---
import { Image } from 'astro:assets';
import type { Product } from '../lib/products';
import { localePath, useTranslations, type Locale } from '../i18n/config';
import AddToQuote from './AddToQuote';
interface Props { product: Product; locale: Locale }
const { product: p, locale } = Astro.props;
const t = useTranslations(locale);
// "1 metric ton", "24 metric tons" (English plural; other languages fall back to the same unit word)
const unit = p.moq.value === 1 ? t(`units.${p.moq.unit}`) : (t(`units.${p.moq.unit}_other`) !== `units.${p.moq.unit}_other` ? t(`units.${p.moq.unit}_other`) : t(`units.${p.moq.unit}`));
// keep the number and its unit on one line, e.g. "5 kg, 10 kg"
const packs = p.unitWeight ? p.unitWeight.replace(/(\d)\s+(?=\p{L})/gu, '$1\u00A0') : '-';
---
<li class="pcard" id={p.slug} data-category={p.category} data-group={p.group}>
  <div class="pic">
    <Image src={p.image} alt={p.name} widths={[240, 480]} sizes="(min-width: 760px) 260px, 45vw" format="webp" loading="lazy" />
  </div>
  <p class="cat">{t(`groups.${p.group}`)}</p>
  <h3>{p.name}</h3>
  <dl class="facts">
    <div><dt>{t('products.moq')}</dt><dd>{p.moq.value}&nbsp;{unit}</dd></div>
    <div><dt>{t('products.weight')}</dt><dd>{packs}</dd></div>
  </dl>
  <div class="actions">
    <AddToQuote client:visible sku={p.sku} moq={p.moq.value} add={t('products.add')} inQuote={t('products.inQuote')} inQuoteShort={t('products.inQuoteShort')} href={localePath(locale, '/quote/')} />
    <p class="price">{t('products.price')}</p>
  </div>
</li>
